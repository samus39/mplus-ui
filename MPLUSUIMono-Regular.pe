#!/usr/bin/fontforge

#------------------------
# M PLUS UI Mono Regular
#------------------------
TARGET_FONT = $1;
MPLUS_BASE_FONT = $2;
MPLUS_OLD_FONT = $3;
MPLUS1_FONT = $4;
VLGOTHIC_FONT = $5;

Open(MPLUS_BASE_FONT);
SetFontNames("MPLUSUIMono-Regular", "M PLUS UI Mono", "M PLUS UI Mono Regular", "Regular", "M PLUS Based Monospace Font", "1.0.0");
SetTTFName(0x409, 1, "M PLUS UI Mono");
SetTTFName(0x409, 2, "Regular");
SetTTFName(0x409, 3, "MPLUSUIMono-Regular");
SetTTFName(0x409, 4, "M PLUS UI Mono Regular");

# U+00B7 MIDDLE DOT (·)
# - remove anchor
Select(0x00b7);
RemoveAnchorClass("Anchor-1");
SetGlyphClass("none");

# U+2010 HYPHEN (‐)
# - copy from U+002D HYPHEN-MINUS
Select(0x002d);
Copy();
Select(0x2010);
Paste();

# U+201B SINGLE HIGH-REVERSED-9 QUOTATION MARK (‛)
# - copy from U+2019 RIGHT SINGLE QUOTATION MARK
# - horizontal flip
Select(0x2019);
Copy();
Select(0x201b);
Paste();
HFlip();
CorrectDirection();

# U+2018 LEFT SINGLE QUOTATION MARK (‘)
# - copy from U+201B SINGLE HIGH-REVERSED-9 QUOTATION MARK
Select(0x201b);
Copy();
Select(0x2018);
Paste();

# U+201F DOUBLE HIGH-REVERSED-9 QUOTATION MARK (‟)
# - copy from U+201D RIGHT DOUBLE QUOTATION MARK
# - horizontal flip
Select(0x201d);
Copy();
Select(0x201f);
Paste();
HFlip();
CorrectDirection();

# U+201C LEFT DOUBLE QUOTATION MARK (“)
# - copy from U+201F DOUBLE HIGH-REVERSED-9 QUOTATION MARK
Select(0x201f);
Copy();
Select(0x201c);
Paste();

# U+2025 TWO DOT LEADER (‥)
Open(MPLUS_OLD_FONT);
Select(0x2025);
Copy();
Open(MPLUS_BASE_FONT);
Select(0x2025);
Paste();

