#!/usr/bin/fontforge

USER_FONTS_DIR = "/home/mx-takashi/.local/share/fonts/";

MPLUS1_REGULAR_FONT = USER_FONTS_DIR + "MPLUS1-Regular.ttf";
MPLUS1P_REGULAR_FONT = USER_FONTS_DIR + "MPLUS1p-Regular.ttf";
MPLUSUI_REGULAR_FONT = "MPLUSUI-Regular.ttf";

MPLUS1_BOLD_FONT = USER_FONTS_DIR + "MPLUS1-Bold.ttf";
MPLUS1P_BOLD_FONT = USER_FONTS_DIR + "MPLUS1p-Bold.ttf";
MPLUSUI_BOLD_FONT = "MPLUSUI-Bold.ttf";

MPLUS1CODE_REGULAR_FONT = USER_FONTS_DIR + "MPLUS1Code-Regular.ttf";
MPLUSUICODE_REGULAR_FONT = "MPLUSUICode-Regular.ttf";

MPLUS1CODE_BOLD_FONT = USER_FONTS_DIR + "MPLUS1Code-Bold.ttf";
MPLUSUICODE_BOLD_FONT = "MPLUSUICode-Bold.ttf";

VLGOTHIC_DIR = "/usr/share/fonts/truetype/vlgothic/";
VLGOTHIC_FONT = VLGOTHIC_DIR + "VL-Gothic-Regular.ttf";
VLPGOTHIC_FONT = VLGOTHIC_DIR + "VL-PGothic-Regular.ttf";

//-------------------
// M PLUS UI Regular
//-------------------
MPLUS_BASE_FONT = MPLUS1_REGULAR_FONT;
MPLUS_OLD_FONT = MPLUS1P_REGULAR_FONT;

Open(MPLUS_BASE_FONT);
SetFontNames("MPLUSUI-Regular", "M PLUS UI", "M PLUS UI Regular", "Regular", "Created by MPLUS and VLGothic", "1.0.0");
SetTTFName(0x409, 1, "M PLUS UI");
SetTTFName(0x409, 2, "Regular");
SetTTFName(0x409, 3, "MPLUSUI-Regular");
SetTTFName(0x409, 4, "M PLUS UI Regular");

// U+00B7 MIDDLE DOT
Select(0x00b7);
//SetWidth(313);  // width of "."
//CenterInWidth();
RemoveAnchorClass("Anchor-2");
SetGlyphClass("none");

// U+2010 HYPHEN
Select(0x002d);
Copy();
Select(0x2010);
Paste();

// U+201B SINGLE HIGH-REVERSED-9 QUOTATION MARK
Select(0x2019);
Copy();
Select(0x201b);
Paste();
HFlip();
CorrectDirection();

// U+201F DOUBLE HIGH-REVERSED-9 QUOTATION MARK
Select(0x201d);
Copy();
Select(0x201f);
Paste();
HFlip();
CorrectDirection();

// U+2236 RATIO
Select(0x003a);
Copy();
Select(0x2236);
Paste();
Move(0, 90);
//SetWidth(515);  // width of "*"
//CenterInWidth();

// U+2E40 DOUBLE HYPHEN
// U+30A0 KATAKANA-HIRAGANA DOUBLE HYPHEN
//Select(0xff1d);
//Copy();
//Select(0x30a0);
//Paste();
//Transform(50, 0, 0, 100, 100, 0);
//SetWidth(1000);
//CenterInWidth();

// M PLUS 1p Regular
MergeFonts(MPLUS_OLD_FONT);

// VL PGothic Regular
//MergeFonts("/usr/share/fonts/truetype/vlgothic/VL-PGothic-Regular.ttf");

// Generate
Generate(MPLUSUI_REGULAR_FONT);
Close();

//----------------
// M PLUS UI Bold
//----------------
